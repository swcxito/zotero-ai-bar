{
  "name": "zotero-ai-bar",
  "type": "module",
  "version": "1.0.0-beta.2",
  "packageManager": "pnpm@10.28.0",
  "description": "A handy ai bar for zotero",
  "config": {
    "addonName": "Zotero AI Bar",
    "addonID": "zaibar@fukeke.com",
    "addonRef": "zaibar",
    "addonInstance": "ZAIBar",
    "prefsPrefix": "extensions.zotero.${addonRef}"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swcxito/zotero-ai-bar.git"
  },
  "author": "swcxito",
  "bugs": {
    "url": "https://github.com/swcxito/zotero-ai-bar/issues"
  },
  "homepage": "https://github.com/swcxito/zotero-ai-bar#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.101",
    "@ai-sdk/anthropic": "^3.0.75",
    "@ai-sdk/azure": "^3.0.63",
    "@ai-sdk/google": "^3.0.68",
    "@ai-sdk/openai": "^3.0.62",
    "@ai-sdk/openai-compatible": "^2.0.46",
    "@ai-sdk/xai": "^3.0.88",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "ai": "^6.0.175",
    "dotenv": "^17.4.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.45",
    "marked": "^17.0.1",
    "marked-highlight": "^2.2.4",
    "marked-katex-extension": "^5.1.8",
    "marked-xhtml": "^1.0.15",
    "pnpm": "^10.33.4",
    "zod": "^4.4.3",
    "zotero-plugin-toolkit": "^5.1.2"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@zotero-plugin/eslint-config": "^0.6.9",
    "autoprefixer": "^10.5.0",
    "chai": "^6.2.1",
    "cssnano": "^7.1.0",
    "esbuild-style-plugin": "^1.6.3",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "postcss": "^8.5.14",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.6",
    "zotero-types": "^4.1.2"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
