{
  "name": "zotero-ai-bar",
  "type": "module",
  "version": "1.2.3-beta.2",
  "packageManager": "pnpm@10.28.0",
  "description": "A handy AI bar for Zotero",
  "config": {
    "addonName": "Zotero AI Bar",
    "addonID": "zaibar@fukeke.com",
    "addonRef": "zaibar",
    "addonInstance": "ZAIBar",
    "prefsPrefix": "extensions.zotero.${addonRef}"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swcxito/zotero-ai-bar.git"
  },
  "author": "swcxito",
  "bugs": {
    "url": "https://github.com/swcxito/zotero-ai-bar/issues"
  },
  "homepage": "https://github.com/swcxito/zotero-ai-bar#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.110",
    "@ai-sdk/anthropic": "^3.0.80",
    "@ai-sdk/azure": "^3.0.67",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/google-vertex": "^4.0.139",
    "@ai-sdk/openai": "^3.0.66",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@ai-sdk/xai": "^3.0.92",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "ai": "^6.0.191",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "marked": "^18.0.4",
    "marked-highlight": "^2.2.4",
    "marked-katex-extension": "^5.1.9",
    "marked-xhtml": "^1.0.15",
    "zotero-plugin-toolkit": "^5.1.2"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@zotero-plugin/eslint-config": "^0.6.9",
    "autoprefixer": "^10.5.0",
    "chai": "^6.2.2",
    "cssnano": "^8.0.1",
    "esbuild-style-plugin": "^1.6.3",
    "eslint": "^10.4.0",
    "mocha": "^11.7.6",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "zotero-plugin-scaffold": "^0.8.6",
    "zotero-types": "^4.1.2"
  }
}
